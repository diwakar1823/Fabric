print("Email content created successfully.")



def build_recipients(email_string):
    if not email_string:
        return []

    return [
        {
            "emailAddress": {
                "address": email.strip()
            }
        }
        for email in email_string.split(",")
        if email.strip()
    ]


def send_email(access_token, sender_mailbox, to_email, cc_email, subject, html_body):
    send_mail_url = f"https://graph.microsoft.com/v1.0/users/{sender_mailbox}/sendMail"

    to_recipients = build_recipients(to_email)
    cc_recipients = build_recipients(cc_email)

    if not to_recipients:
        raise Exception("No valid To recipients were provided.")

    message = {
        "subject": subject,
        "body": {
            "contentType": "HTML",
            "content": html_body
        },
        "toRecipients": to_recipients
    }

    if cc_recipients:
        message["ccRecipients"] = cc_recipients

    payload = {
        "message": message,
        "saveToSentItems": True
    }

    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json"
    }

    response = requests.post(
        send_mail_url,
        headers=headers,
        json=payload,
        timeout=30
    )

    if response.status_code != 202:
        raise Exception(
            f"Email send failed. "
            f"Status: {response.status_code}, Response: {response.text}"
        )

    return "Email submitted successfully."


try:
    result = send_email(
        access_token=graph_token,
        sender_mailbox=sender_mailbox,
        to_email=to_email,
        cc_email=cc_email,
        subject=subject,
        html_body=html_body
    )

    print(result)

except Exception as ex:
    print("Pipeline notification email failed.")
    print(str(ex))
    print(traceback.format_exc())
    raise











