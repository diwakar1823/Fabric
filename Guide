import time
import html
import traceback
import requests
import notebookutils

from azure.keyvault.secrets import SecretClient
from azure.core.credentials import AccessToken, TokenCredential


class FabricCredential(TokenCredential):
    def get_token(self, *scopes, **kwargs):
        token = notebookutils.credentials.getToken("https://vault.azure.net")
        return AccessToken(token, int(time.time()) + 3600)

kv_url = "https://kv-for-data.vault.azure.net/"

try:
    kv_client = SecretClient(
        vault_url=kv_url,
        credential=FabricCredential()
    )

    print("Connected to Key Vault successfully.")

    tenant_id = kv_client.get_secret("sp-tenant-id").value
    client_id = kv_client.get_secret("sp-client-id").value
    client_secret = kv_client.get_secret("sp-client-secret").value
    sender_mailbox = kv_client.get_secret("sender-mailbox").value

    print("Secrets loaded successfully from Key Vault.")
    print(f"Sender mailbox loaded: {sender_mailbox}")

except Exception as ex:
    print("Failed to connect to Key Vault or load secrets.")
    print(str(ex))
    raise


def get_graph_token(tenant_id, client_id, client_secret):
    token_url = f"https://login.microsoftonline.com/{tenant_id}/oauth2/v2.0/token"

    token_body = {
        "grant_type": "client_credentials",
        "client_id": client_id,
        "client_secret": client_secret,
        "scope": "https://graph.microsoft.com/.default"
    }

    response = requests.post(token_url, data=token_body, timeout=30)

    if response.status_code != 200:
        raise Exception(
            f"Token generation failed. "
            f"Status: {response.status_code}, Response: {response.text}"
        )

    token_response = response.json()

    if "access_token" not in token_response:
        raise Exception(f"Access token not found in token response: {token_response}")

    return token_response["access_token"]


graph_token = get_graph_token(
    tenant_id=tenant_id,
    client_id=client_id,
    client_secret=client_secret
)

print("Graph token generated successfully.")



def normalize_pipeline_status(status):
    normalized_status = str(status).strip().lower()

    success_values = ["success", "succeeded", "completed"]
    failure_values = ["fail", "failed", "failure", "error"]

    if normalized_status in success_values:
        return True, "Succeeded", "✅"

    if normalized_status in failure_values:
        return False, "Failed", "❌"

    return False, str(status), "⚠️"


